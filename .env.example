# Server Configuration
PORT=3000
NODE_ENV=development

# LTI 1.1 Configuration (set these in D2L External Learning Tools)
# The consumer key and secret must match what is configured in D2L Brightspace
LTI_CONSUMER_KEY=ksu-discussion-tool
LTI_CONSUMER_SECRET=change-this-to-a-strong-secret

# D2L Brightspace domain(s) that are allowed to frame this tool.
# Comma-separated list. Set this to your school's Brightspace URLs.
LTI_FRAME_ANCESTORS=https://kennesaw.view.usg.edu,https://*.view.usg.edu

# Optional CORS origins for external API calls (comma-separated).
# In development all origins are allowed.
CORS_ORIGIN=

# Sapling AI Detector API Key (free: https://sapling.ai/ai-content-detector)
SAPLING_API_KEY=your-sapling-api-key

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/ksu-discussion

# Session Configuration
SESSION_SECRET=change-this-to-a-random-string-in-production
